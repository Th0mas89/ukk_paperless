###############################################################################
# Paperless-ngx settings                                                      #
###############################################################################

# See http://docs.paperless-ngx.com/configuration/ for all available options.

# The UID and GID of the user used to run paperless in the container. Set this
# to your UID and GID on the host so that you have write access to the
# consumption directory.
#USERMAP_UID=1000
#USERMAP_GID=1000

# See the documentation linked above for all options. A few commonly adjusted settings
# are provided below.

# This is required if you will be exposing Paperless-ngx on a public domain
# (if doing so please consider security measures such as reverse proxy)
#PAPERLESS_URL=https://paperless.example.com

# Required. A unique secret key for session tokens and signing.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=vbf-6gyuDPrpW7FOJRihz2CRfbbWaXTJMTamlZwREK7IRQF95L5DcRsnfpghS_sB-ZBiDUWSx9swmfvBxmy2lQ

# Use this variable to set a timezone for the Paperless Docker containers. Defaults to UTC.
#PAPERLESS_TIME_ZONE=America/Los_Angeles

# The default language to use for OCR. Set this to the language most of your
# documents are written in.
#PAPERLESS_OCR_LANGUAGE=eng

# Additional languages to install for text recognition, separated by a whitespace.
# Note that this is different from PAPERLESS_OCR_LANGUAGE (default=eng), which defines
# the language used for OCR.
# The container installs English, German, Italian, Spanish and French by default.
# See https://packages.debian.org/search?keywords=tesseract-ocr-&searchon=names
# for available languages.
PAPERLESS_OCR_LANGUAGES=deu eng


#PAPERLESS_ADMIN_USER=Thomas.Osterholt@uk-koeln.de
#PAPERLESS_ADMIN_MAIL=Thomas.Osterholt@uk-koeln.de
#PAPERLESS_ADMIN_PASSWORD=Testpasswort



PAPERLESS_AI_ENABLED=true
PAPERLESS_AI_LLM_BACKEND=ollama
PAPERLESS_AI_LLM_MODEL=gemma4:latest
# Ollama läuft auf dem Host (Port 11434), nicht im Container - localhost würde
# hier auf den Container selbst zeigen. host.docker.internal funktioniert auf
# Docker Desktop (macOS/Windows) ohne weitere Konfiguration.
PAPERLESS_AI_LLM_ENDPOINT=http://host.docker.internal:11434
# optional, Default 8192
PAPERLESS_AI_LLM_CONTEXT_SIZE=8192
# optional, Sekunden, Default 120
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=120
# optional
PAPERLESS_AI_LLM_OUTPUT_LANGUAGE=de


# GLM-OCR: ersetzt Tesseract als primäre Texterkennung, sofern aktiviert.
# Läuft ebenfalls über den Ollama-Host, siehe host.docker.internal oben.
# Bei Fehlern (Ollama nicht erreichbar, Modell fehlt, Timeout) wird
# automatisch auf Tesseract zurückgefallen.
PAPERLESS_GLM_OCR_ENABLED=true
PAPERLESS_GLM_OCR_ENDPOINT=http://host.docker.internal:11434
PAPERLESS_GLM_OCR_MODEL=glm-ocr:latest
# optional, Sekunden, Default 120
PAPERLESS_GLM_OCR_REQUEST_TIMEOUT=120

